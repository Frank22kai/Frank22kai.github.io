function setLang(lang) {
  document.querySelectorAll('.lang-opt').forEach(b => b.classList.remove('active'));
  document.querySelector(`.lang-opt[onclick="setLang('${lang}')"]`).classList.add('active');
  const d = T[lang];
  // Use innerHTML so HTML entities (&amp; <br>) render correctly
  document.querySelectorAll('[data-t]').forEach(el => {
    const k = el.getAttribute('data-t');
    if (d[k] !== undefined) el.innerHTML = d[k];
  });
}

/* ===================
   CANVAS BACKGROUND
   =================== */
const canvas = document.getElementById('bg-canvas'), ctx = canvas.getContext('2d');
function resize(){ canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resize(); window.addEventListener('resize', resize);

const pts = Array.from({length:55}, () => ({
  x: Math.random()*window.innerWidth, y: Math.random()*window.innerHeight,
  vx: (Math.random()-.5)*.3, vy: (Math.random()-.5)*.3,
  r: Math.random()*1.3+.4, a: Math.random()*.46+.12
}));
let t = 0;
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height); t += .004;
  ctx.strokeStyle='rgba(0,229,255,.046)'; ctx.lineWidth=.5;
  for(let x=0;x<canvas.width;x+=65){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,canvas.height);ctx.stroke()}
  for(let y=0;y<canvas.height;y+=65){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(canvas.width,y);ctx.stroke()}
  const sy=(Math.sin(t*.35)*.5+.5)*canvas.height;
  const g=ctx.createLinearGradient(0,sy-55,0,sy+55);
  g.addColorStop(0,'transparent');g.addColorStop(.5,'rgba(0,229,255,.045)');g.addColorStop(1,'transparent');
  ctx.fillStyle=g; ctx.fillRect(0,sy-55,canvas.width,110);
  pts.forEach(p=>{
    p.x+=p.vx; p.y+=p.vy;
    if(p.x<0)p.x=canvas.width; if(p.x>canvas.width)p.x=0;
    if(p.y<0)p.y=canvas.height; if(p.y>canvas.height)p.y=0;
    ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
    ctx.fillStyle=`rgba(0,229,255,${p.a})`; ctx.fill();
  });
  for(let i=0;i<pts.length;i++) for(let j=i+1;j<pts.length;j++){
    const dx=pts[i].x-pts[j].x, dy=pts[i].y-pts[j].y, d=Math.sqrt(dx*dx+dy*dy);
    if(d<108){
      ctx.beginPath(); ctx.moveTo(pts[i].x,pts[i].y); ctx.lineTo(pts[j].x,pts[j].y);
      ctx.strokeStyle=`rgba(0,229,255,${.065*(1-d/108)})`; ctx.lineWidth=.5; ctx.stroke();
    }
  }
  requestAnimationFrame(draw);
}
draw();

/* ===================
   SCROLL OBSERVER
   =================== */
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(!e.isIntersecting) return;
    e.target.classList.add('vis');
    // Skill bars
    const fill = e.target.querySelector('.sk-fill');
    if(fill) setTimeout(()=>{ fill.style.width = fill.getAttribute('data-w')+'%'; }, 80);
    // Counters
    const num = e.target.querySelector('[data-count]');
    if(num){
      const tgt = +num.getAttribute('data-count'); let cur = 0; const inc = tgt/32;
      const tmr = setInterval(()=>{
        cur = Math.min(cur+inc, tgt);
        num.textContent = Math.floor(cur) + (tgt===100?'%':'+');
        if(cur>=tgt) clearInterval(tmr);
      }, 38);
    }
  });
}, {threshold:.1, rootMargin:'0px 0px -28px 0px'});

document.querySelectorAll('.reveal,.stat-item').forEach(el => obs.observe(el));

// Stagger service cards
document.querySelectorAll('.svc-card,.svc-card-wide').forEach((c,i) => {
  c.style.transitionDelay = (i % 3) * 0.08 + 's';
});
document.querySelectorAll('.std-card').forEach((c,i) => {
  c.style.transitionDelay = i * 0.055 + 's';
});

/* ---- GALLERY FILTER ---- */
function filterGal(cat) {
  document.querySelectorAll('.gal-tab').forEach(b => b.classList.remove('active'));
  event.currentTarget.classList.add('active');
  document.querySelectorAll('.gal-card').forEach(c => {
    if (cat === 'all' || c.getAttribute('data-cat') === cat) {
      c.classList.remove('hidden');
    } else {
      c.classList.add('hidden');
    }
  });
}

/* ---- LIGHTBOX ---- */
const lb = document.createElement('div');
lb.id = 'lightbox';
lb.innerHTML = '<button id="lb-close" onclick="closeLb()">X CLOSE</button><img id="lb-img" src=""><p id="lb-cap"></p>';
document.body.appendChild(lb);
lb.addEventListener('click', e => { if(e.target === lb) closeLb(); });

document.querySelectorAll('.gal-card').forEach(card => {
  card.addEventListener('click', () => {
    const img = card.querySelector('img');
    const cap = card.querySelector('.gal-cap');
    document.getElementById('lb-img').src = img.src;
    document.getElementById('lb-cap').textContent = cap.textContent;
    document.getElementById('lightbox').classList.add('open');
    document.body.style.overflow = 'hidden';
  });
});

function closeLb() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeLb(); });

