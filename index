<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Frank Jr Design | Mechanical Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#040b14;--bg-card:#07111d;--bg-card2:#0c1926;
  --cyan:#00e5ff;--cyan-dim:#00b8d4;--steel:#4fc3f7;
  --gold:#ffc107;--white:#e6f2fc;--gray:#7a8fa0;
  --border:rgba(0,229,255,.12);--border-hi:rgba(0,229,255,.38);
  --glow:0 0 22px rgba(0,229,255,.28);--glow-s:0 0 44px rgba(0,229,255,.5)
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Rajdhani',sans-serif;background:var(--bg);color:var(--white);overflow-x:hidden}
::-webkit-scrollbar{width:3px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--cyan-dim)}
#bg-canvas{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.28}

/* -- NAV -- */
nav{position:fixed;top:0;width:100%;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:15px 52px;background:rgba(4,11,20,.92);backdrop-filter:blur(24px);border-bottom:1px solid var(--border)}
.nav-logo{font-family:'Orbitron',monospace;font-size:.95rem;font-weight:900;color:var(--cyan);letter-spacing:3px}
.nav-right{display:flex;align-items:center;gap:30px}
.nav-links{display:flex;gap:26px;list-style:none}
.nav-links a{font-size:.76rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--gray);text-decoration:none;transition:color .3s;position:relative}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--cyan);transition:width .3s}
.nav-links a:hover{color:var(--cyan)}
.nav-links a:hover::after{width:100%}
.lang-btn{display:flex;border:1px solid var(--border-hi);overflow:hidden}
.lang-opt{padding:7px 13px;cursor:pointer;background:transparent;color:var(--gray);border:none;font-family:'Share Tech Mono',monospace;font-size:.68rem;letter-spacing:1px;transition:all .22s}
.lang-opt.active{background:var(--cyan);color:#040b14;font-weight:700}

/* -- HERO -- */
#hero{position:relative;z-index:1;min-height:100vh;display:flex;align-items:center;padding:128px 52px 60px;gap:56px}
.hero-left{flex:1;max-width:600px}
.hero-right{flex:1;display:flex;justify-content:center;align-items:center}
.hero-badge{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--border-hi);padding:6px 18px;font-size:.63rem;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:var(--cyan);margin-bottom:26px;background:rgba(0,229,255,.05);animation:fadeUp .8s ease both}
.hero-badge .dot{width:6px;height:6px;background:var(--cyan);border-radius:50%;animation:pulse 2s infinite}
.hero-name{font-family:'Orbitron',monospace;font-size:clamp(2rem,4.8vw,4.1rem);font-weight:900;line-height:1.05;letter-spacing:3px;background:linear-gradient(135deg,#fff 0%,#00e5ff 55%,#4fc3f7 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:fadeUp .9s .15s ease both}
.hero-title{font-size:clamp(.8rem,1.7vw,1.05rem);font-weight:400;color:var(--gray);letter-spacing:4px;text-transform:uppercase;margin-top:12px;animation:fadeUp .9s .3s ease both}
.hero-title strong{color:var(--cyan);font-weight:600}
.hero-divider{width:58px;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);margin:24px 0;animation:fadeIn 1s .5s ease both}
.hero-desc{font-size:.96rem;line-height:1.78;color:rgba(200,220,240,.72);margin-bottom:36px;animation:fadeUp .9s .4s ease both}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;animation:fadeUp .9s .55s ease both}
.btn-p{padding:13px 34px;background:var(--cyan);color:#040b14;font-family:'Rajdhani',sans-serif;font-size:.77rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;border:none;cursor:pointer;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));transition:all .3s;box-shadow:0 0 28px rgba(0,229,255,.38)}
.btn-p:hover{background:#fff;box-shadow:var(--glow-s);transform:translateY(-2px)}
.btn-o{padding:13px 34px;background:transparent;color:var(--cyan);font-family:'Rajdhani',sans-serif;font-size:.77rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;border:1px solid var(--cyan);cursor:pointer;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));transition:all .3s}
.btn-o:hover{background:rgba(0,229,255,.08);box-shadow:var(--glow);transform:translateY(-2px)}

/* -- STATS -- */
.stats-strip{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(0,229,255,.025)}
.stat-item{padding:34px 18px;text-align:center;border-right:1px solid var(--border);transition:background .3s}
.stat-item:last-child{border-right:none}
.stat-item:hover{background:rgba(0,229,255,.06)}
.stat-num{font-family:'Orbitron',monospace;font-size:2.2rem;font-weight:800;color:var(--cyan);line-height:1;display:block}
.stat-lbl{font-size:.65rem;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gray);margin-top:8px;display:block}

/* -- LAYOUT -- */
section{position:relative;z-index:1;padding:86px 52px;max-width:1280px;margin:0 auto}
.sec-label{font-size:.62rem;font-weight:600;letter-spacing:5px;text-transform:uppercase;color:var(--cyan);margin-bottom:10px;display:flex;align-items:center;gap:12px}
.sec-label::before{content:'';width:26px;height:1px;background:var(--cyan)}
.sec-title{font-family:'Orbitron',monospace;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:700;line-height:1.22;margin-bottom:13px}
.sec-desc{font-size:.96rem;color:var(--gray);max-width:540px;line-height:1.72;margin-bottom:52px}

/* -- SERVICE GRID 2+2+1 -- */
.svc-top{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-bottom:none}
.svc-bottom{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-top:none}
.svc-full{border:1px solid var(--border);border-top:none;background:var(--border)}

.svc-card{background:var(--bg-card);padding:40px 36px;position:relative;overflow:hidden;transition:all .4s;display:grid;grid-template-rows:auto auto auto 1fr auto}
.svc-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);transform:scaleX(0);transition:transform .4s}
.svc-card::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at top left,rgba(0,229,255,.07) 0%,transparent 65%);opacity:0;transition:opacity .4s}
.svc-card:hover{background:var(--bg-card2);transform:translateY(-4px)}
.svc-card:hover::before{transform:scaleX(1)}
.svc-card:hover::after{opacity:1}

/* full-width card for steel cost */
.svc-card-wide{background:var(--bg-card);padding:40px 42px;position:relative;overflow:hidden;transition:all .4s;display:grid;grid-template-columns:1fr auto;gap:32px;align-items:start}
.svc-card-wide::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);transform:scaleX(0);transition:transform .4s}
.svc-card-wide::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at center left,rgba(255,193,7,.04) 0%,transparent 60%);opacity:0;transition:opacity .4s}
.svc-card-wide:hover{background:var(--bg-card2);transform:translateY(-4px)}
.svc-card-wide:hover::before{transform:scaleX(1)}
.svc-card-wide:hover::after{opacity:1}
.svc-wide-left{flex:1}
.svc-wide-right{display:flex;align-items:center;justify-content:center;flex-shrink:0}

.svc-num{font-family:'Share Tech Mono',monospace;font-size:.65rem;color:var(--cyan);letter-spacing:2px;margin-bottom:14px;opacity:.6}
.svc-num-gold{font-family:'Share Tech Mono',monospace;font-size:.65rem;color:var(--gold);letter-spacing:2px;margin-bottom:14px;opacity:.7}
.svc-iso{margin-bottom:16px;height:64px;display:flex;align-items:center}
.svc-name{font-family:'Orbitron',monospace;font-size:.92rem;font-weight:600;color:var(--white);margin-bottom:13px;line-height:1.35}
.svc-name-gold{font-family:'Orbitron',monospace;font-size:.92rem;font-weight:600;color:var(--gold);margin-bottom:13px;line-height:1.35}
.svc-desc{font-size:.87rem;color:var(--gray);line-height:1.67}
.svc-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px;align-self:end}
.tag{font-size:.57rem;font-weight:600;letter-spacing:1.4px;text-transform:uppercase;color:var(--cyan-dim);border:1px solid rgba(0,229,255,.18);padding:4px 10px;background:rgba(0,229,255,.05)}
.tag-gold{font-size:.57rem;font-weight:600;letter-spacing:1.4px;text-transform:uppercase;color:#ffc107;border:1px solid rgba(255,193,7,.25);padding:4px 10px;background:rgba(255,193,7,.06)}

/* -- SKILLS -- */
.sk-wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px}
.sk-group-title{font-family:'Orbitron',monospace;font-size:.72rem;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--cyan);margin-bottom:24px;padding-bottom:11px;border-bottom:1px solid var(--border)}
.sk-bar{margin-bottom:18px}
.sk-top{display:flex;justify-content:space-between;margin-bottom:6px}
.sk-name{font-size:.83rem;font-weight:600;color:var(--white)}
.sk-pct{font-family:'Share Tech Mono',monospace;font-size:.7rem;color:var(--cyan)}
.sk-track{height:3px;background:rgba(255,255,255,.06);overflow:hidden}
.sk-fill{height:100%;background:linear-gradient(90deg,var(--cyan-dim),var(--cyan));width:0;transition:width 1.3s cubic-bezier(.25,1,.5,1);box-shadow:0 0 10px rgba(0,229,255,.4);position:relative}
.sk-fill::after{content:'';position:absolute;right:0;top:-2px;width:6px;height:7px;background:var(--cyan);clip-path:polygon(0 50%,100% 0,100% 100%)}
.sw-grid{display:flex;flex-wrap:wrap;gap:9px;margin-top:6px}
.sw-pill{display:flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--border);background:var(--bg-card);font-size:.76rem;font-weight:600;color:var(--white);transition:all .3s}
.sw-pill:hover{border-color:var(--cyan);color:var(--cyan);background:rgba(0,229,255,.05);box-shadow:var(--glow)}
.sw-lv{font-size:.56rem;padding:2px 6px;background:rgba(0,229,255,.1);color:var(--cyan-dim);letter-spacing:1px;text-transform:uppercase}

/* -- STANDARDS -- */
.std-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px}
.std-card{padding:24px 18px;border:1px solid var(--border);background:var(--bg-card);text-align:center;transition:all .35s;position:relative;overflow:hidden}
.std-card:hover{border-color:var(--cyan);box-shadow:var(--glow);transform:translateY(-4px)}
.std-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);transform:scaleX(0);transition:transform .35s}
.std-card:hover::before{transform:scaleX(1)}
.std-name{font-family:'Orbitron',monospace;font-size:.9rem;font-weight:700;color:var(--cyan);margin-bottom:7px}
.std-sub{font-size:.64rem;color:var(--gray);line-height:1.42}

/* -- CONTACT -- */
#contact{position:relative;z-index:1;max-width:100%;border-top:1px solid var(--border)}
.contact-inner{max-width:1280px;margin:0 auto;padding:90px 52px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.contact-left h2{font-family:'Orbitron',monospace;font-size:clamp(1.7rem,3vw,2.6rem);font-weight:800;background:linear-gradient(135deg,#fff,#00e5ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.2;margin-bottom:18px}
.contact-left p{font-size:.97rem;color:var(--gray);line-height:1.72;margin-bottom:32px}
.avail-badge{display:inline-flex;align-items:center;gap:10px;padding:9px 22px;border:1px solid rgba(0,255,120,.28);background:rgba(0,255,120,.05);color:#00ff87;font-size:.68rem;font-weight:600;letter-spacing:3px;text-transform:uppercase}
.avail-badge .dot{width:7px;height:7px;background:#00ff87;border-radius:50%;animation:pulse 2s infinite}

.contact-right{display:flex;flex-direction:column;gap:14px}
.c-card{display:flex;align-items:center;gap:16px;padding:20px 24px;border:1px solid var(--border);background:var(--bg-card);text-decoration:none;color:var(--white);transition:all .3s;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px))}
.c-card:hover{border-color:var(--cyan);color:var(--cyan);background:rgba(0,229,255,.06);box-shadow:var(--glow);transform:translateX(6px)}
.c-icon{width:38px;height:38px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;transition:all .3s}
.c-card:hover .c-icon{border-color:var(--cyan);background:rgba(0,229,255,.08)}
.c-info{display:flex;flex-direction:column;gap:2px}
.c-label{font-size:.6rem;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gray);font-family:'Share Tech Mono',monospace}
.c-value{font-size:.9rem;font-weight:600;letter-spacing:.5px}
.lic-strip{margin-top:8px;padding:14px 20px;border:1px solid var(--border);background:rgba(0,229,255,.03);font-family:'Share Tech Mono',monospace;font-size:.64rem;color:var(--gray);letter-spacing:1.5px;text-align:center}

footer{position:relative;z-index:1;text-align:center;padding:26px;border-top:1px solid var(--border);font-size:.66rem;color:var(--gray);letter-spacing:2px;font-family:'Share Tech Mono',monospace}

/* -- ANIMATIONS -- */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(.7)}}
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-13px)}}

.reveal{opacity:0;transform:translateY(26px);transition:all .7s cubic-bezier(.25,1,.5,1)}
.reveal.vis{opacity:1;transform:translateY(0)}

.iso-hero{width:100%;max-width:500px;filter:drop-shadow(0 0 30px rgba(0,229,255,.22));animation:floatY 5.5s ease-in-out infinite}

/* -- RESPONSIVE -- */
@media(max-width:1000px){
  nav{padding:14px 22px}.nav-links{display:none}
  #hero{flex-direction:column;padding:100px 22px 42px}.hero-right{width:100%;max-width:340px;margin:0 auto}
  .svc-top,.svc-bottom,.svc-full{grid-template-columns:1fr}
  .svc-card-wide{grid-template-columns:1fr}.svc-wide-right{display:none}
  .sk-wrap{grid-template-columns:1fr;gap:44px}
  .contact-inner{grid-template-columns:1fr;gap:48px}
  section{padding:66px 22px}
  .stats-strip{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>
<canvas id="bg-canvas"></canvas>

<!-- NAV -->
<nav>
  <div class="nav-logo">FRANK JR<span style="color:var(--white);opacity:.5;margin:0 4px">/</span>DESIGN</div>
  <div class="nav-right">
    <ul class="nav-links">
      <li><a href="#services" data-t="nav_svc">Services</a></li>
      <li><a href="#skills"   data-t="nav_sk">Skills</a></li>
      <li><a href="#portfolio" data-t="nav_port">Portfolio</a></li>
      <li><a href="#standards" data-t="nav_std">Standards</a></li>
      <li><a href="#contact"  data-t="nav_ct">Contact</a></li>
    </ul>
    <div class="lang-btn">
      <button class="lang-opt active" onclick="setLang('en')">EN</button>
      <button class="lang-opt"        onclick="setLang('es')">ES</button>
    </div>
  </div>
</nav>

<!-- HERO -->
<section id="hero" style="padding-top:130px;padding-bottom:40px;max-width:100%">
  <div class="hero-left">
    <div class="hero-badge"><span class="dot"></span><span data-t="badge">Available for Global Remote Projects</span></div>
    <h1 class="hero-name">FRANK JR<span style="-webkit-text-fill-color:rgba(255,255,255,.28);letter-spacing:2px"> /</span> DESIGN</h1>
    <p style="font-family:'Share Tech Mono',monospace;font-size:.68rem;letter-spacing:3px;color:var(--cyan-dim);margin-bottom:6px;animation:fadeUp .9s .22s ease both">FRANK JR. PALACIO PÁJARO</p>
    <p class="hero-title">Mechanical Engineer &middot; <strong>CAD/CAM</strong> &middot; <strong>CNC</strong> &middot; <strong data-t="hero_og">Oil &amp; Gas</strong></p>
    <div class="hero-divider"></div>
    <p class="hero-desc" data-t="hero_desc">Advanced manufacturing solutions — from concept to production floor. 5+ years delivering precision 3D design, CNC programming, FEM structural analysis, steel cost engineering, and Oil &amp; Gas compliance under the most demanding international standards.</p>
    <div class="hero-cta">
      <a href="#contact" class="btn-p" data-t="btn_hire">Hire Me</a>
      <a href="#services" class="btn-o" data-t="btn_svc">View Services</a>
    </div>
  </div>
  <div class="hero-right">
    <!-- ISOMETRIC HERO SCENE -->
    <svg class="iso-hero" viewBox="0 0 500 440" xmlns="http://www.w3.org/2000/svg" fill="none">
      <defs>
        <linearGradient id="gT" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#00e5ff" stop-opacity=".82"/><stop offset="100%" stop-color="#005060" stop-opacity=".5"/></linearGradient>
        <linearGradient id="gL" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#00b0c8" stop-opacity=".42"/><stop offset="100%" stop-color="#002030" stop-opacity=".32"/></linearGradient>
        <linearGradient id="gR" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#00c0dc" stop-opacity=".52"/><stop offset="100%" stop-color="#003040" stop-opacity=".38"/></linearGradient>
      </defs>
      <!-- Main cube -->
      <polygon points="250,50 385,122 250,194 115,122" fill="url(#gT)" opacity=".9"/>
      <polygon points="115,122 250,194 250,310 115,238" fill="url(#gL)" opacity=".92"/>
      <polygon points="385,122 250,194 250,310 385,238" fill="url(#gR)" opacity=".87"/>
      <polygon points="250,50 385,122 250,194 115,122" fill="none" stroke="#00e5ff" stroke-width="1.1" opacity=".72"/>
      <polygon points="115,122 250,194 250,310 115,238" fill="none" stroke="#00e5ff" stroke-width=".8" opacity=".46"/>
      <polygon points="385,122 250,194 250,310 385,238" fill="none" stroke="#00e5ff" stroke-width=".8" opacity=".46"/>
      <line x1="115" y1="122" x2="115" y2="238" stroke="#00e5ff" stroke-width=".75" opacity=".42"/>
      <line x1="385" y1="122" x2="385" y2="238" stroke="#00e5ff" stroke-width=".75" opacity=".42"/>
      <line x1="250" y1="194" x2="250" y2="310" stroke="#00e5ff" stroke-width=".75" opacity=".42"/>
      <!-- top face grid -->
      <line x1="183" y1="86" x2="318" y2="158" stroke="#00e5ff" stroke-width=".38" opacity=".32"/>
      <line x1="216" y1="68" x2="351" y2="140" stroke="#00e5ff" stroke-width=".38" opacity=".22"/>
      <line x1="150" y1="104" x2="285" y2="176" stroke="#00e5ff" stroke-width=".38" opacity=".22"/>
      <line x1="300" y1="86" x2="165" y2="158" stroke="#00e5ff" stroke-width=".38" opacity=".28"/>
      <line x1="340" y1="108" x2="205" y2="180" stroke="#00e5ff" stroke-width=".38" opacity=".2"/>
      <!-- Small floating cube top-right -->
      <g transform="translate(368,25)">
        <polygon points="52,16 88,36 52,56 16,36" fill="rgba(0,200,220,.42)" stroke="#00e5ff" stroke-width=".85" opacity=".72"/>
        <polygon points="16,36 52,56 52,92 16,72" fill="rgba(0,90,115,.42)" stroke="#00e5ff" stroke-width=".65" opacity=".44"/>
        <polygon points="88,36 52,56 52,92 88,72" fill="rgba(0,130,155,.36)" stroke="#00e5ff" stroke-width=".65" opacity=".44"/>
      </g>
      <!-- Cylinder right-bottom -->
      <g transform="translate(358,228)">
        <ellipse cx="48" cy="24" rx="36" ry="17" fill="rgba(0,175,205,.42)" stroke="#00e5ff" stroke-width=".88" opacity=".78"/>
        <rect x="12" y="24" width="72" height="68" fill="rgba(0,90,118,.35)"/>
        <line x1="12" y1="24" x2="12" y2="92" stroke="#00e5ff" stroke-width=".6" opacity=".42"/>
        <line x1="84" y1="24" x2="84" y2="92" stroke="#00e5ff" stroke-width=".6" opacity=".42"/>
        <ellipse cx="48" cy="92" rx="36" ry="17" fill="rgba(0,55,75,.52)" stroke="#00e5ff" stroke-width=".78" opacity=".58"/>
        <ellipse cx="48" cy="92" rx="20" ry="9" fill="rgba(4,11,20,.82)" stroke="#00e5ff" stroke-width=".55" opacity=".65"/>
        <ellipse cx="48" cy="28" rx="36" ry="17" fill="none" stroke="#00e5ff" stroke-width="1.05" opacity=".42"/>
